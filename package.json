{
  "name": "grounded-route",
  "private": true,
  "version": "0.1.0-m0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "workflow:check": "python3 scripts/workflow_guard.py",
    "fixture:check": "python3 scripts/validate_fixture.py",
    "tdd:check": "python3 scripts/tdd_guard.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.24.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^8.2.2",
    "vitest": "^3.1.1"
  }
}
